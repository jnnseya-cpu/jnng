# Public canonical URL of the deployed site (no trailing slash).
# Used for SEO metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://groupejnn.com

# Contact form endpoint. The Zod-validated contact form POSTs JSON here.
# Works with Formspree, a Resend server route, Firebase Functions, HubSpot,
# Salesforce, Zoho or any custom API. Never put private API keys here — only
# a public submission URL.
# Example: https://formspree.io/f/your-form-id
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Newsletter subscription endpoint. The footer signup POSTs {email, locale,
# consent} JSON here (Formspree, Buttondown, Brevo form, or custom API).
# While empty, the form falls back to a prefilled subscription email.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Measurement tags (public IDs, not secrets). Both are consent-gated: nothing
# loads until the visitor accepts the cookie banner, which only appears when
# at least one ID is set. Events tracked: page views (incl. SPA navigation),
# contact-form leads, newsletter signups, outbound platform clicks.
# Meta Pixel ID from Meta Events Manager, e.g. 1234567890
NEXT_PUBLIC_META_PIXEL_ID=
# Google tag / GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# GoatCounter site code for the public per-article view counter
# (create a free site at goatcounter.com; the code is the subdomain,
# e.g. "groupejnn" for groupejnn.goatcounter.com). Cookieless — runs
# without the consent banner. Unset = counter hidden, nothing loads.
NEXT_PUBLIC_GOATCOUNTER_CODE=
